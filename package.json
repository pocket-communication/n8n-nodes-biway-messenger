{
  "name": "n8n-nodes-biway-messenger",
  "version": "0.1.0",
  "description": "n8n community node for Bi-Way Messaging API (SMS / RCS / email)",
  "keywords": [
    "n8n-community-node-package"
  ],
  "license": "MIT",
  "author": {
    "name": "Bi-Way"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint nodes credentials --ext .ts",
    "lintfix": "eslint nodes credentials --ext .ts --fix",
    "prepublishOnly": "npm run build && npm run lint"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/BiwayMessengerApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/BiwayMessenger/BiwayMessenger.node.js",
      "dist/nodes/BiwayMessenger/BiwayMessengerTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n_io/eslint-config": "*",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^8.56.0",
    "n8n-workflow": "*",
    "typescript": "^5.3.0"
  }
}
