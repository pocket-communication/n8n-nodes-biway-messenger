				"options": {}
			},
			"id": "adeccdbb-39ec-443f-a433-a7c05300706e",
			"name": "Read the rating",
			"type": "n8n-nodes-base.set",
			"typeVersion": 3.4,
			"position": [
				220,
				360
			]
		},
		{
			"parameters": {
