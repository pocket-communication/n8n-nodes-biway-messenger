							"display": true,
							"type": "string",
							"canBeUsedToMatch": false
						},
						{
							"id": "phone",
							"displayName": "Phone (international format, e.g. +33612345678)",
							"required": false,
							"defaultMatch": false,
							"display": true,
							"type": "string",
							"canBeUsedToMatch": false
						}
					]
				},
				"ifExists": "update",
				"matchOn": "email",
				"options": {}
			},
			"id": "db3c3713-260b-4a0d-a75f-eceac1019aaa",
			"name": "Save the participant",
