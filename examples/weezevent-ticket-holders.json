			"id": "2414cae5-b317-4ce4-a812-66870a07e667",
			"name": "Get new participants",
			"type": "n8n-nodes-base.httpRequest",
			"typeVersion": 4.2,
			"position": [
				660,
				0
			]
		},
		{
			"parameters": {
				"jsCode": "// Remember the time of this answer for the next run, then output the participants.\nconst answer = $input.first().json;\nconst memory = $getWorkflowStaticData('global');\nif (answer.server_time) memory.since = answer.server_time;\nconst token = $('Get a Weezevent token').first().json.accessToken;\nreturn (answer.participants || []).map((participant) => ({ json: { ...participant, accessToken: token } }));"
			},
			"id": "c5d4e7bc-8405-4ec7-a8b5-da47b76a6b3c",
			"name": "One item per participant",
			"type": "n8n-nodes-base.code",
			"typeVersion": 2,
			"position": [
				880,
				0
			]
		},
		{
			"parameters": {
				"url": "=https://api.weezevent.com/participant/{{ $json.id_participant }}/answers",
				"sendQuery": true,
				"queryParameters": {
					"parameters": [
						{
							"name": "api_key",
							"value": "YOUR_WEEZEVENT_API_KEY"
						},
						{
							"name": "access_token",
							"value": "={{ $json.accessToken }}"
						}
					]
				},
				"options": {}
			},
			"id": "250a08a6-7b53-4b66-a8d7-c8eecca00629",
			"name": "Get the form answers",
			"type": "n8n-nodes-base.httpRequest",
			"typeVersion": 4.2,
			"position": [
				1100,
				0
			]
		},
		{
			"parameters": {
				"mode": "runOnceForEachItem",
				"jsCode": "// The phone number, if the registration form asks for it, in international format.\nconst participant = $('One item per participant').item.json;\nconst owner = participant.owner || {};\nconst answer = ($json.answers || []).find((a) => /t[ée]l[ée]phone|portable|mobile|phone/i.test(a.label || ''));\nlet phone = String((answer && answer.value) || '').replace(/[\\s.-]/g, '');\nif (/^0[1-9]\\d{8}$/.test(phone)) phone = '+33' + phone.slice(1);\nreturn {\n\tjson: {\n\t\tfirstName: owner.first_name || '',\n\t\tlastName: owner.last_name || '',\n\t\temail: owner.email || '',\n\t\tphone,\n\t},\n};"
			},
			"id": "408390b1-fa8b-4b91-a8e9-dd46582f2d5f",
