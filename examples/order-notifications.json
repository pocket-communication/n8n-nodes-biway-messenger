{
	"name": "Bi-Way: WooCommerce order notifications",
	"nodes": [
		{
			"parameters": {
				"content": "## WooCommerce order notifications\nWhen an order is completed in WooCommerce, sends an RCS card with a **Track my parcel** button. Phones that cannot receive RCS get an SMS with the tracking link.\n\n### Setup\n1. **WooCommerce** credential; the trigger creates the webhook in your shop when the workflow is published. WooCommerce reports every change of an order: a completed order changed again sends a new message.\n2. **Bi-Way API** credential. An RCS agent launched by the French operators (check it with the Bi-Way node: RCS Agent › Get Status). Without one, set the channel of the Bi-Way nodes to your SMS channel, and Content to Text where they send a card: the buttons are then left out.\n3. In **Build the tracking link**, replace `https://tracking.example.com/` by the tracking page of your carrier, or read the link your shipping plugin stores in the order.",
				"height": 360,
				"width": 520
			},
			"id": "10cec411-d1ba-48cd-a771-90478202a012",
			"name": "Sticky Note setup",
			"type": "n8n-nodes-base.stickyNote",
			"typeVersion": 1,
			"position": [
				-80,
				-460
			]
		},
		{
			"parameters": {
				"content": "### Phone numbers\nWooCommerce stores the number as the customer typed it: this node turns a French number such as 06 12 34 56 78 into +33612345678. Adapt it for other countries.",
				"height": 170,
				"width": 340
			},
			"id": "84ec2af2-4cab-4f8d-a59a-1922abb99766",
			"name": "Sticky Note phone",
			"type": "n8n-nodes-base.stickyNote",
			"typeVersion": 1,
			"position": [
				480,
				-300
			]
		},
		{
			"parameters": {
				"event": "order.updated"
			},
			"id": "31e69b28-7a9e-4f17-abcf-2c82889f2860",
			"name": "Order updated",
			"type": "n8n-nodes-base.wooCommerceTrigger",
			"typeVersion": 1,
			"position": [
				0,
				0
			],
			"webhookId": "bbd44dad-d910-4d22-a9e4-b4d3318cfb61"
		},
		{
			"parameters": {
				"conditions": {
					"options": {
						"caseSensitive": true,
						"leftValue": "",
						"typeValidation": "loose",
						"version": 2
					},
					"conditions": [
						{
							"id": "12ac546c-2458-4042-a3bb-27e1469ac1a7",
							"leftValue": "={{ $json.status }}",
							"rightValue": "completed",
							"operator": {
								"type": "string",
								"operation": "equals"
							}
						}
					],
					"combinator": "and"
				},
				"options": {}
			},
			"id": "3e997ee6-af3d-43c9-ad43-cfd392b06fe0",
			"name": "Only completed orders",
			"type": "n8n-nodes-base.filter",
			"typeVersion": 2.2,
			"position": [
				220,
				0
			]
		},
		{
			"parameters": {
				"assignments": {
					"assignments": [
						{
							"id": "e2cff5b8-f321-420c-a270-0bbc30bc9ee0",
							"name": "phone",
							"value": "={{ String($json.billing.phone || '').replace(/[\\s.-]/g, '').replace(/^0(?=[1-9])/, '+33') }}",
							"type": "string"
						},
						{
							"id": "47c67596-aca7-4860-a5fb-13785675d9d3",
							"name": "firstName",
							"value": "={{ $json.billing.first_name }}",
							"type": "string"
						},
						{
							"id": "7b113d64-1823-4f6c-af61-1c5341fb9027",
							"name": "orderNumber",
							"value": "={{ $json.number }}",
							"type": "string"
						},
						{
							"id": "b5a55fc5-fd93-4ee3-ad07-b53b220f1654",
							"name": "trackingUrl",
							"value": "=https://tracking.example.com/{{ $json.number }}",
							"type": "string"
						}
					]
				},
				"options": {}
			},
			"id": "90f30206-6161-4e2a-aa96-b6f443bff1db",
			"name": "Build the tracking link",
			"type": "n8n-nodes-base.set",
			"typeVersion": 3.4,
			"position": [
				440,
				0
			]
		},
		{
			"parameters": {
				"resource": "message",
				"operation": "send",
				"channel": "rcs",
				"content": "card",
				"source": "raw",
				"cardImage": "none",
				"cardTitle": "=Order {{ $json.orderNumber }} is on its way",
				"cardText": "=Hello {{ $json.firstName }}, your order has left our warehouse. Follow your parcel with the button below.",
				"rcsButtons": {
					"openUrl": [
						{
							"text": "Track my parcel",
							"url": "={{ $json.trackingUrl }}"
						}
					]
				},
				"rcsFallback": "custom",
				"rcsFallbackText": "=Your order {{ $json.orderNumber }} is on its way. Track it: {{ $json.trackingUrl }}",
				"receiver": "={{ $json.phone }}",
				"options": {}
			},
			"id": "bfbece03-e2d3-4d45-aa1e-b7b6841499ae",
			"name": "Send the shipping card",
			"type": "n8n-nodes-biway-messenger.biway",
			"typeVersion": 1,
			"position": [
				680,
				0
			]
		}
	],
	"connections": {
		"Order updated": {
			"main": [
				[
					{
						"node": "Only completed orders",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Only completed orders": {
			"main": [
				[
					{
						"node": "Build the tracking link",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Build the tracking link": {
			"main": [
				[
					{
						"node": "Send the shipping card",
						"type": "main",
						"index": 0
					}
				]
			]
		}
	},
	"pinData": {},
	"settings": {
		"executionOrder": "v1"
	},
	"meta": {
		"templateCredsSetupCompleted": false
	}
}
