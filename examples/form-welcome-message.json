							"type": "string",
							"canBeUsedToMatch": false
						},
						{
							"id": "email",
							"displayName": "Email (email address)",
							"required": false,
							"defaultMatch": false,
							"display": true,
							"type": "string",
							"canBeUsedToMatch": false
						}
					]
				},
				"ifExists": "update",
				"matchOn": "phone",
				"options": {}
			},
			"id": "68c5814b-5b10-4443-a6f8-184ff9d60db3",
			"name": "Save the contact",
