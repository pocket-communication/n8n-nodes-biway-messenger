		},
		{
			"parameters": {
				"resource": "contact",
				"operation": "create",
				"contactColumns": {
					"mappingMode": "defineBelow",
					"value": {
						"surname": "={{ $json['First name'] }}",
						"name": "={{ $json['Last name'] }}",
						"phone": "={{ $json.Phone }}",
						"email": "={{ $json.Email }}"
					},
					"matchingColumns": [],
